# .env.example
# Copy this file to .env and fill in your own values.
# Never commit .env to source control.

# Flask settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret keys — generate strong random strings for production
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-string
JWT_SECRET_KEY=replace-with-a-different-strong-random-string

# Database URI
# SQLite (development):  sqlite:///productivity.db
# PostgreSQL (prod):     postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///productivity.db
